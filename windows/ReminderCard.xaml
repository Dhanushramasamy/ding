<Window x:Class="Ding.ReminderCard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ding reminder"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        SizeToContent="WidthAndHeight" Left="-10000" Top="-10000">

    <!-- Margin leaves room for the shadow; transparent pixels let clicks through. -->
    <Grid Margin="28">
        <Border x:Name="Card" MinWidth="300" Opacity="0" RenderTransformOrigin="0.5,1"
                Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource Stroke}"
                BorderThickness="1" CornerRadius="10" Padding="22,20,22,16">
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="CardScale" ScaleX="0.4" ScaleY="0.4" />
                    <TranslateTransform x:Name="CardOffset" Y="20" />
                </TransformGroup>
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="10" Direction="270" Opacity="0.28" Color="Black" />
            </Border.Effect>
            <StackPanel>
                <TextBlock x:Name="MessageText" MaxWidth="380" TextWrapping="Wrap" LineHeight="27"
                           FontFamily="{StaticResource DisplayFont}" FontSize="20" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                    <Button Content="Snooze" Style="{StaticResource SubtleButton}" MinWidth="84" Margin="0,0,8,0" Click="OnSnooze" />
                    <Button Content="Done" Style="{StaticResource AccentButton}" MinWidth="84" Click="OnDone" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
