<Window x:Class="Ding.CoverWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ding — Hide Everything"
        WindowStyle="None" ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False"
        Background="#0A0A0A" Left="-10000" Top="-10000" Width="400" Height="300">

    <!-- Solid, so nothing underneath can show through. -->
    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#171717" Offset="0" />
                <GradientStop Color="#070707" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock x:Name="ClockText" HorizontalAlignment="Center" FontFamily="{StaticResource DisplayFont}"
                       FontSize="112" FontWeight="Light" Foreground="White" />
            <TextBlock x:Name="DateText" HorizontalAlignment="Center" Margin="0,0,0,32" FontFamily="{StaticResource UIFont}"
                       FontSize="22" Foreground="#8CFFFFFF" />
            <Button Content="Show Everything" Style="{StaticResource AccentButton}" HorizontalAlignment="Center"
                    Padding="22,10" FontSize="15" Click="OnShow" />
            <TextBlock Text="Esc or Ctrl+Alt+H" HorizontalAlignment="Center" Margin="0,16,0,0"
                       FontFamily="{StaticResource UIFont}" FontSize="12" Foreground="#59FFFFFF" />
        </StackPanel>
    </Grid>
</Window>
